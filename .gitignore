# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# e2e screenshots
/e2e/screenshots/

# generated screenshot originals (compressed copies are in docs/screenshots/)
/public/screenshots/

# superpowers brainstorming artifacts
.superpowers/

# design docs
docs/superpowers/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build backups & stray logs
/.next.bak*/
/_*.log

# AI 工具/IDE 代理目录（本地产物，含个人环境信息）
/.agents/
/.claude/
/.codebuddy/
/.hermes/
/.lingma/
/.workbuddy/
/.workbuddy-ai/

# 第三方技能包（体积大且非项目源码）
/skills/
skills-lock.json

.vercel
